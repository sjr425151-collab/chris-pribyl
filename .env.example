# Copy to .env.local for local development. Never commit real credentials.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical production origin (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.dynamicroofingmi.com
# Search engines are told NOT to index the site unless this is "true".
# Keep it unset on previews/staging so they never compete with the live site.
NEXT_PUBLIC_ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Lead delivery (server only — never prefix with NEXT_PUBLIC_)
# A submission is only reported as successful when at least one channel below
# confirms delivery.
# ---------------------------------------------------------------------------
# Email via Resend (https://resend.com). Requires a verified sending domain.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# CRM / automation webhook (Zapier, Make, HubSpot, JobNimbus, etc.)
LEAD_WEBHOOK_URL=
# Optional: HMAC-SHA256 signs the webhook body (header: x-dynamic-signature)
LEAD_WEBHOOK_SECRET=
# Development storage: writes submissions to ./.data/leads as JSON.
# Not persistent on serverless hosts — do not rely on it in production.
LEAD_STORE_LOCAL=true

# ---------------------------------------------------------------------------
# Analytics (optional; loads only after the visitor accepts cookies)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional scheduling link shown after a successful submission (Calendly, etc.)
NEXT_PUBLIC_SCHEDULING_URL=
