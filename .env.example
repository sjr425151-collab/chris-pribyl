# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — public values (safe for the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only. NEVER prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Future milestones (leave empty until implemented)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
